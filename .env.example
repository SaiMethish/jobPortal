# ============================================================
# JobPortal Backend - Environment Variables Template
# Copy this file to .env.prod (or export as env vars) and fill in the values.
# DO NOT COMMIT REAL PRODUCTION PASSWORDS TO GIT.
# ============================================================

# Active Profile: 'local' for local dev, 'prod' for production
SPRING_PROFILES_ACTIVE=prod

# --- Database Configuration (e.g. Neon PostgreSQL) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:5432/<database>?sslmode=require
SPRING_DATASOURCE_USERNAME=<db_username>
SPRING_DATASOURCE_PASSWORD=<db_password>

# --- Redis Configuration (e.g. Upstash Redis) ---
SPRING_DATA_REDIS_HOST=<redis_host>
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_USERNAME=default
SPRING_DATA_REDIS_PASSWORD=<redis_password>
SPRING_DATA_REDIS_SSL_ENABLED=true
SPRING_DATA_REDIS_TIMEOUT=5000

# --- Google OAuth2 Authentication ---
GOOGLE_CLIENT_ID=<google_client_id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<google_client_secret>

# --- Supabase Cloud Storage ---
SUPABASE_URL=https://<project_ref>.supabase.co
SUPABASE_KEY=<supabase_service_role_or_secret_key>
SUPABASE_STORAGE_BUCKET=resumes
